{
  "name": "examproof",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "2e4b6106e0174f6e9172d26f5366584d" }],
  "vars": {
    "NEBIUS_BASE_URL": "https://api.tokenfactory.nebius.com/v1/",
    "MODEL_NANO": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
    "MODEL_VISION": "nvidia/Nemotron-3.5-Super-VL",
    "MODEL_ULTRA": "nvidia/Nemotron-3-Ultra-550b-a55b",
    "RUNS_PER_HOUR": "20"
  },
  "observability": { "enabled": true }
}
